{
  "name": "portal-gecep",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/comando-local.mjs vite",
    "build": "node scripts/comando-local.mjs vinext build",
    "start": "node scripts/comando-local.mjs vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:local": "node scripts/testar-servidor.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/comando-local.mjs drizzle-kit generate",
    "db:migrate:local": "node scripts/comando-local.mjs wrangler d1 migrations apply portal-gecep-local --local",
    "db:migrate:remote": "node scripts/comando-local.mjs wrangler d1 migrations apply portal-gecep-local --remote",
    "deploy": "npm run build && node scripts/comando-local.mjs wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "GECEP \u2014 Gr\u00eamio Estudantil do CEP"
}
